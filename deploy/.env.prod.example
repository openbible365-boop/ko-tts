# ===== ko-tts 生产环境变量 =====
# 用法: 复制为 deploy/.env.prod 并填入真实值。
#   cp deploy/.env.prod.example deploy/.env.prod
# .env.prod / .env 已被 .gitignore 忽略, 切勿提交。

# --- PostgreSQL (postgres 容器初始化用) ---
POSTGRES_USER=kotts
POSTGRES_PASSWORD=<填这里>
POSTGRES_DB=kotts

# --- 数据库连接 (后端 asyncpg 用) ---
# host 必须是 compose 服务名 postgres; 端口 5432; 账号密码库名要和上面一致
DATABASE_URL=postgresql+asyncpg://kotts:<填这里, 同 POSTGRES_PASSWORD>@postgres:5432/kotts

# --- Cloudflare R2 (S3 兼容) ---
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<填这里>
R2_SECRET_ACCESS_KEY=<填这里>
R2_BUCKET=ob-tts-data

# --- 安全 ---
# 生成: openssl rand -hex 32
JWT_SECRET=<填这里, 32+ 字符随机串>

# --- 应用 ---
ENVIRONMENT=prod
CORS_ORIGINS=https://kr-tts.openbible.live

# --- 可选 ---
LOG_LEVEL=info
TZ=Asia/Singapore
